{
  "name": "nexus",
  "version": "0.1.3",
  "description": "NEXUS AI — Autonomous Agentic Desktop Application",
  "author": "SARGUNAM K",
  "main": "electron/main.js",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": ".\\.venv\\Scripts\\python.exe -m nexus.main --mode api",
    "dev": "concurrently -n \"frontend,backend,electron\" -c \"cyan,green,blue\" \"npm run dev:frontend\" \"npm run dev:backend\" \"wait-on http://127.0.0.1:5173 http-get://127.0.0.1:8000/api/health -t 60000 && electron .\"",
    "build:frontend": "npm --prefix frontend run build",
    "package": "npm run build:frontend && electron-builder build --win"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.nexus.ai.desktop",
    "productName": "Seyal AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist_backend/nexus_backend.exe",
        "to": "backend/nexus_backend.exe"
      },
      {
        "from": ".env",
        "to": "backend/.env"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "appx"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "appx": {
      "publisherDisplayName": "SARGUNAM K",
      "publisher": "CN=2FDF5732-8711-4493-BFEE-182F498E2D65",
      "identityName": "NexusAI.SeyalAI",
      "applicationId": "NexusAI"
    }
  }
}